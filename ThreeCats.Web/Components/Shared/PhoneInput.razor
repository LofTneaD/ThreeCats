@inherits InputBase<string>

<input @attributes="AdditionalAttributes"
	   class="@CssClass"
	   type="tel"
	   inputmode="tel"
	   autocomplete="tel"
	   placeholder="+7 (___) ___-__-__"
	   value="@CurrentValueAsString"
	   @oninput="HandleInput" />

@code {
	private void HandleInput(ChangeEventArgs args)
	{
		CurrentValueAsString = FormatPhone(args.Value?.ToString());
	}

	private static string FormatPhone(string? value)
	{
		var digits = new string(
			(value ?? string.Empty)
				.Where(char.IsDigit)
				.ToArray());

		if (digits.Length == 0)
			return string.Empty;

		if (digits.StartsWith('8'))
			digits = "7" + digits[1..];
		else if (!digits.StartsWith('7'))
			digits = "7" + digits;

		if (digits.Length > 11)
			return value ?? string.Empty;

		var result = "+7";

		if (digits.Length > 1)
			result += " (" + digits.Substring(1, Math.Min(3, digits.Length - 1));

		if (digits.Length >= 5)
			result += ") " + digits.Substring(4, Math.Min(3, digits.Length - 4));

		if (digits.Length >= 8)
			result += "-" + digits.Substring(7, Math.Min(2, digits.Length - 7));

		if (digits.Length >= 11)
			result += "-" + digits.Substring(9, 2);

		return result;
	}

	protected override bool TryParseValueFromString(
		string? value,
		out string result,
		out string? validationErrorMessage)
	{
		result = value ?? string.Empty;
		validationErrorMessage = null;
		return true;
	}
}
