@inherits LayoutComponentBase

<div class="app-layout">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <div class="main-area">
        <header class="topbar">
            <div class="topbar-title">
                <span class="topbar-eyebrow">Ветеринарная клиника</span>
                <h1>Три кота</h1>
            </div>

            <div class="topbar-info">
                <span class="topbar-status"></span>
                <span>CRM-система</span>
            </div>
        </header>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <button type="button" class="dismiss" aria-label="Закрыть">×</button>
</div>
