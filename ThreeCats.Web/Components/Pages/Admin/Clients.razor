@page "/admin/clients"

@using System.ComponentModel.DataAnnotations
@using ThreeCats.Application.Interfaces.Services
@using ThreeCats.Application.DTOs.Clients
@using ThreeCats.Application.Models.Pagination
@using ThreeCats.Web.Components.Shared

@inject IClientManagementService ClientManagement

<PageTitle>Управление клиентами</PageTitle>

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Управление клиентами</h2>
            <p class="text-muted">
                Список клиентов ветеринарной клиники
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="StartCreate">
            Добавить клиента
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    @if (isLoading)
    {
        <p>Загрузка клиентов...</p>
    }
    else if (clients.Count == 0)
    {
        <div class="alert alert-info">
            Клиенты пока не добавлены.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ФИО</th>
                        <th>Телефон</th>
                        <th>Email</th>
                        <th>Адрес</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var client in clients)
                    {
                        <tr @key="client.Id">
                            <td>
                                @client.LastName
                                @client.FirstName
                                @client.MiddleName
                            </td>

                            <td>@client.PhoneNumber</td>

                            <td>@(client.Email ?? "Не указан")</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(client.Address)
                                    ? "Не указан"
                                    : client.Address)
                            </td>

                            <td>
                                @if (client.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Активен
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Неактивен
                                    </span>
                                }
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary me-2"
                                        @onclick="() => StartEdit(client)">
                                    Изменить
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmDelete(client)">
                                    Удалить
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

		<div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted">
                Всего клиентов: @totalCount
            </div>

            @if (totalPages > 1)
            {
                <nav aria-label="Навигация по страницам">
                    <div class="d-flex align-items-center gap-2">

                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                disabled="@(currentPage <= 1 || isLoading)"
                                @onclick="() => GoToPageAsync(currentPage - 1)">
                            Назад
                        </button>

                        <span>
                            Страница @currentPage из @totalPages
                        </span>

                        <button type="button"
                                class="btn btn-outline-primary btn-sm"
                                disabled="@(currentPage >= totalPages || isLoading)"
                                @onclick="() => GoToPageAsync(currentPage + 1)">
                            Далее
                        </button>

                    </div>
                </nav>
            }
        </div>
    }

    @if (showForm)
    {
        <div class="card mt-4 mb-4">
            <div class="card-header">
                <h4 class="mb-0">
                    @(editingId.HasValue
                        ? "Редактирование клиента"
                        : "Добавление клиента")
                </h4>
            </div>

            <div class="card-body">
                <EditForm Model="formModel"
                          OnValidSubmit="SaveAsync"
                          FormName="ClientForm">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <h5 class="mb-3">Личные данные</h5>

                    <div class="mb-3">
                        <label class="form-label">Фамилия</label>

                        <InputText class="form-control"
                                   @bind-Value="formModel.LastName" />

                        <ValidationMessage
                            For="@(() => formModel.LastName)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Имя</label>

                        <InputText class="form-control"
                                   @bind-Value="formModel.FirstName" />

                        <ValidationMessage
                            For="@(() => formModel.FirstName)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Отчество</label>

                        <InputText class="form-control"
                                   @bind-Value="formModel.MiddleName" />
                    </div>

                    <hr />

                    <h5 class="mb-3">Учётная запись</h5>

                    <div class="mb-3">
                        <label class="form-label">Номер телефона</label>

                        <PhoneInput class="form-control"
								@bind-Value="formModel.PhoneNumber" />

                        <ValidationMessage
                            For="@(() => formModel.PhoneNumber)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Электронная почта</label>

                        <InputText class="form-control"
                                   @bind-Value="formModel.Email" />

                        <ValidationMessage
                            For="@(() => formModel.Email)" />
                    </div>

                    @if (!editingId.HasValue)
                    {
                        <div class="mb-3">
                            <label class="form-label">Пароль</label>

                            <InputText type="password"
                                       class="form-control"
                                       @bind-Value="formModel.Password" />

                            <ValidationMessage
                                For="@(() => formModel.Password)" />
                        </div>
                    }

                    <hr />

                    <h5 class="mb-3">Данные клиента</h5>

                    <div class="mb-3">
                        <label class="form-label">Адрес проживания</label>

                        <InputText class="form-control"
                                   @bind-Value="formModel.Address" />

                        <ValidationMessage
                            For="@(() => formModel.Address)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Дополнительные заметки
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="formModel.Notes" />

                        <ValidationMessage
                            For="@(() => formModel.Notes)" />
                    </div>

                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input"
                                       @bind-Value="formModel.IsActive" />

                        <label class="form-check-label">
                            Клиент активен
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary me-2"
                            disabled="@isSaving">
                        @(isSaving ? "Сохранение..." : "Сохранить")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelForm"
                            disabled="@isSaving">
                        Отмена
                    </button>

                </EditForm>
            </div>
        </div>
    }

    @if (clientToDelete is not null)
    {
        <div class="alert alert-warning mt-3">
            <p>
                Вы действительно хотите удалить профиль клиента
                <strong>
                    @clientToDelete.LastName
                    @clientToDelete.FirstName
                    @clientToDelete.MiddleName
                </strong>?
            </p>

            <p>
                Учётная запись пользователя при этом останется в системе.
            </p>

            <button type="button"
                    class="btn btn-danger me-2"
                    @onclick="DeleteAsync"
                    disabled="@isSaving">
                Подтвердить удаление
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelDelete"
                    disabled="@isSaving">
                Отмена
            </button>
        </div>
    }

</div>

@code {
    private List<ClientDto> clients = [];

	private int currentPage = 1;
	private const int pageSize = 10;
	private int totalPages;
	private int totalCount;

    private bool isLoading = true;
    private bool isSaving;
    private bool showForm;

    private Guid? editingId;

    private ClientFormModel formModel = new();

    private ClientDto? clientToDelete;

    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
{
    isLoading = true;
    errorMessage = null;

    try
    {
        var result = await ClientManagement.GetAllAsync(
            new PagedRequest
            {
                PageNumber = currentPage,
                PageSize = pageSize
            });

        totalCount = result.TotalCount;
        totalPages = result.TotalPages;

        if (currentPage > totalPages)
        {
            currentPage = Math.Max(totalPages, 1);

            if (totalPages > 0)
            {
                result = await ClientManagement.GetAllAsync(
                    new PagedRequest
                    {
                        PageNumber = currentPage,
                        PageSize = pageSize
                    });
            }
        }

        clients = result.Items.ToList();
    }
    catch (Exception ex)
    {
        errorMessage = $"Не удалось загрузить список клиентов: {ex.Message}";
    }
    finally
    {
        isLoading = false;
    }
}

	private async Task GoToPageAsync(int page)
	{
		if (page < 1 || page > totalPages || page == currentPage)
			return;

		currentPage = page;
		await LoadClientsAsync();
	}

    private void StartCreate()
    {
        errorMessage = null;
        successMessage = null;

        editingId = null;

        formModel = new ClientFormModel
        {
            IsActive = true,
            IsEditing = false
        };

        showForm = true;
    }

    private void StartEdit(ClientDto client)
    {
        errorMessage = null;
        successMessage = null;

        editingId = client.Id;

        formModel = new ClientFormModel
        {
            LastName = client.LastName,
            FirstName = client.FirstName,
            MiddleName = client.MiddleName,
            PhoneNumber = client.PhoneNumber ?? string.Empty,
            Email = client.Email,
            Address = client.Address,
            Notes = client.Notes,
            IsActive = client.IsActive,
            IsEditing = true
        };

        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        successMessage = null;

        isSaving = true;

        try
        {
            if (editingId.HasValue)
            {
                var dto = new UpdateClientDto(
                    editingId.Value,
                    formModel.LastName.Trim(),
                    formModel.FirstName.Trim(),
                    NormalizeOptional(formModel.MiddleName),
                    formModel.PhoneNumber.Trim(),
                    NormalizeOptional(formModel.Email),
                    formModel.Address.Trim(),
                    formModel.Notes.Trim(),
                    formModel.IsActive
                );

                var updated = await ClientManagement.UpdateAsync(dto);

                if (!updated)
                {
                    errorMessage =
                        "Клиент не найден. Возможно, профиль был удалён.";

                    return;
                }

                successMessage = "Данные клиента успешно обновлены.";
            }
            else
            {
                var dto = new CreateClientDto(
                    formModel.LastName.Trim(),
                    formModel.FirstName.Trim(),
                    NormalizeOptional(formModel.MiddleName),
                    formModel.PhoneNumber.Trim(),
                    NormalizeOptional(formModel.Email),
                    formModel.Password,
                    formModel.Address.Trim(),
                    formModel.Notes.Trim(),
                    formModel.IsActive
                );

                await ClientManagement.CreateAsync(dto);

                successMessage = "Клиент успешно добавлен.";
            }

            showForm = false;
            editingId = null;

            await LoadClientsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? null
            : value.Trim();
    }

    private void ConfirmDelete(ClientDto client)
    {
        errorMessage = null;
        successMessage = null;

        clientToDelete = client;
    }

    private void CancelDelete()
    {
        clientToDelete = null;
    }

    private async Task DeleteAsync()
    {
        if (clientToDelete is null)
            return;

        errorMessage = null;
        successMessage = null;

        isSaving = true;

        try
        {
            var deleted = await ClientManagement.DeleteAsync(
                clientToDelete.Id);

            if (!deleted)
            {
                errorMessage = "Клиент не найден или уже удалён.";
                return;
            }

            successMessage = "Профиль клиента успешно удалён.";

            clientToDelete = null;

            await LoadClientsAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                "Не удалось удалить профиль клиента. " +
                "Возможно, с ним связаны питомцы или записи на приём. " +
                ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed class ClientFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Введите фамилию.")]
        [StringLength(100)]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Введите имя.")]
        [StringLength(100)]
        public string FirstName { get; set; } = string.Empty;

        [StringLength(100)]
        public string? MiddleName { get; set; }

        [Required(ErrorMessage = "Введите номер телефона.")]
        [StringLength(20)]
        public string PhoneNumber { get; set; } = string.Empty;

        [EmailAddress(
            ErrorMessage = "Введите корректный адрес электронной почты.")]
        [StringLength(255)]
        public string? Email { get; set; }

        public string Password { get; set; } = string.Empty;

        [StringLength(500)]
        public string Address { get; set; } = string.Empty;

        [StringLength(2000)]
        public string Notes { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;

        public bool IsEditing { get; set; }

        public IEnumerable<ValidationResult> Validate(
            ValidationContext validationContext)
        {
            if (!IsEditing && string.IsNullOrWhiteSpace(Password))
            {
                yield return new ValidationResult(
                    "Введите пароль для новой учётной записи.",
                    [nameof(Password)]);
            }
        }
    }
}
