@page "/admin/pets"

@using System.ComponentModel.DataAnnotations
@using ThreeCats.Application.DTOs.Pets
@using ThreeCats.Application.DTOs.Clients
@using ThreeCats.Application.DTOs.Users
@using ThreeCats.Application.Interfaces.Pets
@using ThreeCats.Application.Interfaces.Services
@using ThreeCats.Application.Interfaces.Users
@using ThreeCats.Domain.Enums
@using ThreeCats.Application.Models.Pagination

@inject IPetManagementService PetManagement
@inject IClientManagementService ClientManagement
@inject IUserManagementService UserManagement

<PageTitle>Управление питомцами</PageTitle>

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Управление питомцами</h2>
            <p class="text-muted">
                Список зарегистрированных питомцев клиники
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                @onclick="StartCreate"
                disabled="@isLoading">
            Добавить питомца
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    @if (isLoading)
    {
        <p>Загрузка питомцев...</p>
    }
    else if (pets.Count == 0)
    {
        <div class="alert alert-info">
            Питомцы пока не добавлены.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Кличка</th>
                        <th>Вид</th>
                        <th>Порода</th>
                        <th>Пол</th>
                        <th>Дата рождения</th>
                        <th>Вес</th>
                        <th>Владелец</th>
                        <th>Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var pet in pets)
                    {
                        <tr @key="pet.Id">
                            <td>
                                <strong>@pet.Name</strong>
                            </td>

                            <td>@pet.Species</td>

                            <td>@pet.Breed</td>

                            <td>@GetSexName(pet.Sex)</td>

                            <td>@pet.BirthDate.ToString("dd.MM.yyyy")</td>

                            <td>
                                @(pet.Weight.HasValue
                                    ? $"{pet.Weight.Value:F2} кг"
                                    : "Не указан")
                            </td>

                            <td>@GetClientName(pet.ClientId)</td>

                            <td>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary me-2"
                                        @onclick="() => StartEdit(pet)">
                                    Изменить
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ConfirmDelete(pet)">
                                    Удалить
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

		@if (pets.Count > 0)
		{
			<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
				<div class="text-muted">
					Всего питомцев: @totalCount
				</div>

				@if (totalPages > 1)
				{
					<nav aria-label="Навигация по страницам">
						<div class="d-flex align-items-center gap-2">
							<button type="button"
									class="btn btn-outline-primary btn-sm"
									disabled="@(currentPage <= 1)"
									@onclick="() => GoToPageAsync(currentPage - 1)">
								Назад
							</button>

							<span>Страница @currentPage из @totalPages</span>

							<button type="button"
									class="btn btn-outline-primary btn-sm"
									disabled="@(currentPage >= totalPages)"
									@onclick="() => GoToPageAsync(currentPage + 1)">
								Далее
							</button>
						</div>
					</nav>
				}
			</div>
		}
    }

    @if (showForm)
    {
        <div class="card mt-4 mb-4">
            <div class="card-header">
                <h4 class="mb-0">
                    @(editingId.HasValue
                        ? "Редактирование питомца"
                        : "Добавление питомца")
                </h4>
            </div>

            <div class="card-body">
                <EditForm Model="formModel"
                          OnValidSubmit="SaveAsync"
                          FormName="PetForm">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    @if (!editingId.HasValue)
                    {
                        <div class="mb-3">
                            <label class="form-label">Владелец</label>

                            <InputSelect class="form-select"
                                         @bind-Value="formModel.ClientId">
                                <option value="@Guid.Empty">
                                    Выберите владельца
                                </option>

                                @foreach (var client in clients)
                                {
                                    <option value="@client.ClientId">
                                        @client.FullName
                                        (@client.PhoneNumber)
                                    </option>
                                }
                            </InputSelect>

                            <ValidationMessage
                                For="@(() => formModel.ClientId)" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Владелец</label>

                            <input class="form-control"
                                   value="@GetClientName(formModel.ClientId)"
                                   disabled />
                        </div>
                    }

                    <hr />

                    <h5 class="mb-3">Информация о питомце</h5>

                    <div class="mb-3">
                        <label class="form-label">Кличка</label>

                        <InputText class="form-control"
                                   @bind-Value="formModel.Name" />

                        <ValidationMessage
                            For="@(() => formModel.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Вид животного</label>

                        <InputText class="form-control"
                                   placeholder="Например, кошка или собака"
                                   @bind-Value="formModel.Species" />

                        <ValidationMessage
                            For="@(() => formModel.Species)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Порода</label>

                        <InputText class="form-control"
                                   placeholder="Например, британская короткошёрстная"
                                   @bind-Value="formModel.Breed" />

                        <ValidationMessage
                            For="@(() => formModel.Breed)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Пол</label>

                        <InputSelect class="form-select"
                                     @bind-Value="formModel.Sex">
                            <option value="@PetSex.Male">Самец</option>
                            <option value="@PetSex.Female">Самка</option>
                            <option value="@PetSex.Unknown">Неизвестно</option>
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дата рождения</label>

                        <InputDate TValue="DateOnly"
                                   class="form-control"
                                   @bind-Value="formModel.BirthDate" />

                        <ValidationMessage
                            For="@(() => formModel.BirthDate)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Вес (кг)</label>

                        <InputNumber TValue="decimal?"
                                     class="form-control"
                                     step="0.01"
                                     @bind-Value="formModel.Weight" />

                        <ValidationMessage
                            For="@(() => formModel.Weight)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Дополнительные заметки</label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="formModel.Notes" />

                        <ValidationMessage
                            For="@(() => formModel.Notes)" />
                    </div>

                    <button type="submit"
                            class="btn btn-primary me-2"
                            disabled="@isSaving">
                        @(isSaving ? "Сохранение..." : "Сохранить")
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CancelForm"
                            disabled="@isSaving">
                        Отмена
                    </button>

                </EditForm>
            </div>
        </div>
    }

    @if (petToDelete is not null)
    {
        <div class="alert alert-warning mt-3">
            <p>
                Вы действительно хотите удалить питомца
                <strong>@petToDelete.Name</strong>?
            </p>

            <p class="mb-3">
                Это действие может быть невозможно, если с питомцем
                связаны записи на приём или медицинские данные.
            </p>

            <button type="button"
                    class="btn btn-danger me-2"
                    @onclick="DeleteAsync"
                    disabled="@isSaving">
                Подтвердить удаление
            </button>

            <button type="button"
                    class="btn btn-secondary"
                    @onclick="CancelDelete"
                    disabled="@isSaving">
                Отмена
            </button>
        </div>
    }

</div>

@code {
    private List<PetDto> pets = [];

	private int currentPage = 1;
	private const int pageSize = 10;
	private int totalPages;
	private int totalCount;

    private List<ClientOption> clients = [];

    private bool isLoading = true;
    private bool isSaving;
    private bool showForm;

    private Guid? editingId;

    private PetFormModel formModel = new();

    private PetDto? petToDelete;

    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var petResult = await PetManagement.GetAllAsync(
			new PagedRequest
			{
				PageNumber = currentPage,
				PageSize = pageSize
			});
            var clientResult = await ClientManagement.GetAllForSelectionAsync();
            var userResult = await UserManagement.GetAllForSelectionAsync();

            pets = petResult.Items.ToList();

            var usersById = userResult.ToDictionary(
                user => user.Id);

            clients = clientResult
                .Where(client => usersById.ContainsKey(client.UserId))
                .Select(client =>
                {
                    var user = usersById[client.UserId];

                    return new ClientOption(
                        client.Id,
                        $"{user.LastName} {user.FirstName} {user.MiddleName}".Trim(),
                        user.PhoneNumber ?? "Телефон не указан");
                })
                .OrderBy(client => client.FullName)
                .ToList();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось загрузить данные питомцев и владельцев.";
        }
        finally
        {
            isLoading = false;
        }
    }

	private async Task GoToPageAsync(int page)
	{
		if (page < 1 || page > totalPages || page == currentPage)
			return;

		currentPage = page;
		await LoadDataAsync();
	}

    private string GetClientName(Guid clientId)
    {
        return clients.FirstOrDefault(client =>
                   client.ClientId == clientId)?.FullName
               ?? "Владелец не найден";
    }

    private static string GetSexName(PetSex sex)
    {
        return sex switch
        {
            PetSex.Male => "Самец",
            PetSex.Female => "Самка",
            PetSex.Unknown => "Неизвестно",
            _ => "Не указан"
        };
    }

    private void StartCreate()
    {
        errorMessage = null;
        successMessage = null;

        editingId = null;

        formModel = new PetFormModel
        {
            ClientId = Guid.Empty,
            Sex = PetSex.Unknown,
            BirthDate = DateOnly.FromDateTime(DateTime.Today)
        };

        showForm = true;
    }

    private void StartEdit(PetDto pet)
    {
        errorMessage = null;
        successMessage = null;

        editingId = pet.Id;

        formModel = new PetFormModel
        {
            ClientId = pet.ClientId,
            Name = pet.Name,
            Species = pet.Species,
            Breed = pet.Breed,
            Sex = pet.Sex,
            BirthDate = pet.BirthDate,
            Weight = pet.Weight,
            Notes = pet.Notes
        };

        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
        editingId = null;
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        successMessage = null;

        isSaving = true;

        try
        {
            if (editingId.HasValue)
            {
                var dto = new UpdatePetDto(
                    editingId.Value,
                    formModel.Name.Trim(),
                    formModel.Species.Trim(),
                    formModel.Breed.Trim(),
                    formModel.Sex,
                    formModel.BirthDate,
                    formModel.Weight,
                    NormalizeNotes(formModel.Notes));

                var updated = await PetManagement.UpdateAsync(dto);

                if (!updated)
                {
                    errorMessage = "Питомец не найден. Возможно, он был удалён.";
                    return;
                }

                successMessage = "Данные питомца успешно обновлены.";
            }
            else
            {
                var dto = new CreatePetDto(
                    formModel.ClientId,
                    formModel.Name.Trim(),
                    formModel.Species.Trim(),
                    formModel.Breed.Trim(),
                    formModel.Sex,
                    formModel.BirthDate,
                    formModel.Weight,
                    NormalizeNotes(formModel.Notes));

                await PetManagement.CreateAsync(dto);

                successMessage = "Питомец успешно добавлен.";
            }

            showForm = false;
            editingId = null;

            await LoadDataAsync();
        }
        catch (Exception)
        {
            errorMessage = "Не удалось сохранить данные питомца.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string? NormalizeNotes(string? notes)
    {
        return string.IsNullOrWhiteSpace(notes)
            ? null
            : notes.Trim();
    }

    private void ConfirmDelete(PetDto pet)
    {
        errorMessage = null;
        successMessage = null;

        petToDelete = pet;
    }

    private void CancelDelete()
    {
        petToDelete = null;
    }

    private async Task DeleteAsync()
    {
        if (petToDelete is null)
            return;

        errorMessage = null;
        successMessage = null;

        isSaving = true;

        try
        {
            var deleted = await PetManagement.DeleteAsync(
                petToDelete.Id);

            if (!deleted)
            {
                errorMessage = "Питомец не найден или уже удалён.";
                return;
            }

            successMessage = "Питомец успешно удалён.";

            petToDelete = null;

            await LoadDataAsync();
        }
        catch (Exception)
        {
            errorMessage =
                "Не удалось удалить питомца. Возможно, с ним связаны " +
                "записи на приём или медицинские данные.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private sealed record ClientOption(
        Guid ClientId,
        string FullName,
        string PhoneNumber);

    private sealed class PetFormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Введите кличку питомца.")]
        [StringLength(100,
            ErrorMessage = "Кличка не должна превышать 100 символов.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Укажите вид животного.")]
        [StringLength(100,
            ErrorMessage = "Вид животного не должен превышать 100 символов.")]
        public string Species { get; set; } = string.Empty;

        [Required(ErrorMessage = "Укажите породу.")]
        [StringLength(100,
            ErrorMessage = "Порода не должна превышать 100 символов.")]
        public string Breed { get; set; } = string.Empty;

        public Guid ClientId { get; set; }

        public PetSex Sex { get; set; } = PetSex.Unknown;

        public DateOnly BirthDate { get; set; } =
            DateOnly.FromDateTime(DateTime.Today);

        public decimal? Weight { get; set; }

        [StringLength(2000,
            ErrorMessage = "Заметки не должны превышать 2000 символов.")]
        public string? Notes { get; set; }

        public IEnumerable<ValidationResult> Validate(
            ValidationContext validationContext)
        {
            if (ClientId == Guid.Empty)
            {
                yield return new ValidationResult(
                    "Выберите владельца питомца.",
                    [nameof(ClientId)]);
            }

            if (BirthDate > DateOnly.FromDateTime(DateTime.Today))
            {
                yield return new ValidationResult(
                    "Дата рождения не может быть в будущем.",
                    [nameof(BirthDate)]);
            }

            if (Weight.HasValue && Weight.Value <= 0)
            {
                yield return new ValidationResult(
                    "Вес должен быть больше нуля.",
                    [nameof(Weight)]);
            }

            if (Weight.HasValue && Weight.Value > 999.99m)
            {
                yield return new ValidationResult(
                    "Вес не может превышать 999.99 кг.",
                    [nameof(Weight)]);
            }
        }
    }
}
