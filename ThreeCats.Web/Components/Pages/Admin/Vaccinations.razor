@page "/admin/vaccinations"

@using ThreeCats.Application.DTOs.Vaccinations
@using ThreeCats.Application.DTOs.Pets
@using ThreeCats.Application.DTOs.Clients
@using ThreeCats.Application.DTOs.Visits
@using ThreeCats.Application.Interfaces.Vaccinations
@using ThreeCats.Application.Interfaces.Pets
@using ThreeCats.Application.Interfaces.Services
@using ThreeCats.Application.Interfaces.Visits
@using ThreeCats.Application.Models.Pagination

@inject IVaccinationManagementService VaccinationManagement
@inject IPetManagementService PetManagement
@inject IClientManagementService ClientManagement
@inject IVisitManagementService VisitManagement
@inject IJSRuntime JS

<PageTitle>Вакцинации | Три кота</PageTitle>

<div class="container-fluid mt-4">

	<div class="d-flex justify-content-between align-items-center mb-4">
		<div>
			<h2>Вакцинации</h2>
			<p class="text-muted mb-0">
				Учёт прививок и сроков следующей вакцинации питомцев
			</p>
		</div>

		<button class="btn btn-primary"
				@onclick="OpenCreateForm">
			+ Добавить вакцинацию
		</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(errorMessage))
	{
		<div class="alert alert-danger">
			@errorMessage
		</div>
	}

	@if (!string.IsNullOrWhiteSpace(successMessage))
	{
		<div class="alert alert-success">
			@successMessage
		</div>
	}

	@if (isLoading)
	{
		<p>Загрузка вакцинаций...</p>
	}
	else if (vaccinations.Count == 0)
	{
		<div class="alert alert-info">
			Записей о вакцинациях пока нет.
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table table-hover align-middle">
				<thead class="table-light">
					<tr>
						<th>Питомец</th>
						<th>Владелец</th>
						<th>Вакцина</th>
						<th>Номер партии</th>
						<th>Дата вакцинации</th>
						<th>Следующая вакцинация</th>
						<th style="width: 150px;">Действия</th>
					</tr>
				</thead>

				<tbody>
					@foreach (var vaccination in vaccinations)
					{
						var pet = GetPet(vaccination.PetId);
						var client = pet is null
							? null
							: GetClient(pet.ClientId);

						<tr @key="vaccination.Id">
							<td>
								@if (pet is not null)
								{
									<div class="fw-semibold">@pet.Name</div>
									<small class="text-muted">@pet.Species</small>
								}
								else
								{
									<span class="text-muted">Не найден</span>
								}
							</td>

							<td>
								@if (client is not null)
								{
									@client.LastName@client.FirstName
								}
								else
								{
									<span class="text-muted">Не найден</span>
								}
							</td>

							<td>@vaccination.VaccineName</td>

							<td>
								@(string.IsNullOrWhiteSpace(vaccination.BatchNumber)
									? "—"
									: vaccination.BatchNumber)
							</td>

							<td>
								@vaccination.VaccinatedAt.ToString("dd.MM.yyyy")
							</td>

							<td>
								@if (vaccination.NextDueAt.HasValue)
								{
									var isOverdue =
										vaccination.NextDueAt.Value <
										DateOnly.FromDateTime(DateTime.Today);

									<span class="@(isOverdue ? "text-danger fw-semibold" : "")">
										@vaccination.NextDueAt.Value.ToString("dd.MM.yyyy")
									</span>

									@if (isOverdue)
									{
										<div>
											<span class="badge bg-danger">
												Просрочена
											</span>
										</div>
									}
								}
								else
								{
									<span class="text-muted">Не указана</span>
								}
							</td>

							<td>
								<div class="d-flex gap-2">
									<button class="btn btn-sm btn-outline-primary"
											@onclick="() => OpenEditForm(vaccination)">
										Изменить
									</button>

									<button class="btn btn-sm btn-outline-danger"
											@onclick="() => DeleteVaccination(vaccination)">
										Удалить
									</button>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		@if (vaccinations.Count > 0)
		{
			<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
				<div class="text-muted">
					Всего записей о вакцинациях: @totalCount
				</div>

				@if (totalPages > 1)
				{
					<nav aria-label="Навигация по страницам">
						<div class="d-flex align-items-center gap-2">
							<button type="button"
									class="btn btn-outline-primary btn-sm"
									disabled="@(currentPage <= 1)"
									@onclick="() => GoToPageAsync(currentPage - 1)">
								Назад
							</button>

							<span>Страница @currentPage из @totalPages</span>

							<button type="button"
									class="btn btn-outline-primary btn-sm"
									disabled="@(currentPage >= totalPages)"
									@onclick="() => GoToPageAsync(currentPage + 1)">
								Далее
							</button>
						</div>
					</nav>
				}
			</div>
		}
	}
</div>

@if (isFormOpen)
{
	<div class="modal d-block"
		 tabindex="-1"
		 style="background-color: rgba(0,0,0,0.5);"
		 role="dialog">

		<div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
			<div class="modal-content">

				<div class="modal-header">
					<h5 class="modal-title">
						@(isEditing ? "Редактирование вакцинации" : "Новая вакцинация")
					</h5>

					<button type="button"
							class="btn-close"
							@onclick="CloseForm">
					</button>
				</div>

				<div class="modal-body">

					@if (!isEditing)
					{
						<div class="mb-3">
							<label class="form-label">Питомец *</label>

							<input class="form-control mb-2"
								   value="@petSearchTerm"
								   @oninput="SearchPetsAsync"
								   placeholder="Поиск по кличке, виду или породе" />

							<select class="form-select"
									@bind="selectedPetId"
									@bind:after="OnPetChanged">

								<option value="">Выберите питомца</option>

								@foreach (var pet in pets)
								{
									<option value="@pet.Id">
										@pet.Name (@pet.Species)
									</option>
								}
							</select>
						</div>
					}
					else
					{
						<div class="mb-3">
							<label class="form-label">Питомец</label>

							<input class="form-control"
								   value="@GetPetName(selectedPetId)"
								   disabled />
						</div>
					}

					<div class="mb-3">
						<label class="form-label">
							Связанный визит
						</label>

						<select class="form-select"
								@bind="selectedVisitId">

							<option value="">Не привязывать к визиту</option>

							@foreach (var visit in visits)
							{
								<option value="@visit.Id">
									@GetVisitDescription(visit)
								</option>
							}
						</select>

						<div class="form-text">
							При необходимости можно связать вакцинацию
							с конкретным визитом.
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label">Название вакцины *</label>

						<input class="form-control"
							   @bind="vaccineName"
							   placeholder="Например, Nobivac Rabies" />
					</div>

					<div class="mb-3">
						<label class="form-label">Номер партии</label>

						<input class="form-control"
							   @bind="batchNumber"
							   placeholder="Номер партии вакцины" />
					</div>

					<div class="row">
						<div class="col-md-6 mb-3">
							<label class="form-label">
								Дата вакцинации *
							</label>

							<InputDate TValue="DateOnly"
									   class="form-control"
									   @bind-Value="vaccinatedAt" />
						</div>

						<div class="col-md-6 mb-3">
							<label class="form-label">
								Следующая вакцинация
							</label>

							<InputDate TValue="DateOnly?"
									   class="form-control"
									   @bind-Value="nextDueAt" />
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label">Заметки</label>

						<textarea class="form-control"
								  rows="3"
								  @bind="notes">
                        </textarea>
					</div>

				</div>

				<div class="modal-footer">
					<button class="btn btn-secondary"
							@onclick="CloseForm">
						Отмена
					</button>

					<button class="btn btn-primary"
							@onclick="SaveVaccination">
						Сохранить
					</button>
				</div>

			</div>
		</div>
	</div>
}

@code {
	private List<VaccinationDto> vaccinations = new();

	private int currentPage = 1;
	private const int pageSize = 10;
	private int totalPages;
	private int totalCount;

	// Результаты поиска для формы.
	private List<PetDto> pets = new();

	// Визиты выбранного питомца.
	private List<VisitDto> visits = new();

	// Данные питомцев и владельцев текущей страницы.
	private readonly Dictionary<Guid, PetDto> petsById = new();
	private readonly Dictionary<Guid, ClientDto> clientsById = new();

	private string petSearchTerm = string.Empty;

	private bool isLoading = true;
	private bool isFormOpen;
	private bool isEditing;

	private Guid? selectedPetId;
	private Guid? selectedVisitId;
	private Guid editingVaccinationId;

	private string vaccineName = string.Empty;
	private string batchNumber = string.Empty;
	private DateOnly vaccinatedAt = DateOnly.FromDateTime(DateTime.Today);
	private DateOnly? nextDueAt;
	private string notes = string.Empty;

	private string? errorMessage;
	private string? successMessage;

	protected override async Task OnInitializedAsync()
	{
		await LoadData();
	}

	private async Task LoadData()
	{
		try
		{
			isLoading = true;
			errorMessage = null;

			var result = await VaccinationManagement.GetAllAsync(
				new PagedRequest
				{
					PageNumber = currentPage,
					PageSize = pageSize
				});

			vaccinations = result.Items.ToList();
			totalCount = result.TotalCount;
			totalPages = result.TotalPages;

			petsById.Clear();
			clientsById.Clear();

			// Загружаем только питомцев текущей страницы.
			foreach (var petId in vaccinations
						 .Select(vaccination => vaccination.PetId)
						 .Distinct())
			{
				var pet = await PetManagement.GetByIdAsync(petId);

				if (pet is null)
					continue;

				petsById[pet.Id] = pet;

				if (!clientsById.ContainsKey(pet.ClientId))
				{
					var client = await ClientManagement.GetByIdAsync(
						pet.ClientId);

					if (client is not null)
						clientsById[client.Id] = client;
				}
			}
		}
		catch (Exception ex)
		{
			errorMessage = $"Не удалось загрузить данные: {ex.Message}";
		}
		finally
		{
			isLoading = false;
		}
	}

	private PetDto? GetPet(Guid id)
	{
		return petsById.GetValueOrDefault(id);
	}

	private ClientDto? GetClient(Guid id)
	{
		return clientsById.GetValueOrDefault(id);
	}

	private string GetPetName(Guid? id)
	{
		if (!id.HasValue)
			return "Питомец не найден";

		return GetPet(id.Value)?.Name ?? "Питомец не найден";
	}

	private string GetVisitDescription(VisitDto visit)
	{
		return $"Визит от {visit.CreatedAt:dd.MM.yyyy}";
	}

	private async Task SearchPetsAsync(ChangeEventArgs args)
	{
		petSearchTerm = args.Value?.ToString() ?? string.Empty;

		pets = (await PetManagement.SearchForSelectionAsync(
			petSearchTerm)).ToList();
	}

	private async Task LoadPetVisitsAsync()
	{
		visits.Clear();

		if (!selectedPetId.HasValue)
			return;

		visits = (await VisitManagement.GetForVaccinationSelectionAsync(
			selectedPetId.Value,
			isEditing ? editingVaccinationId : null)).ToList();
	}

	private async Task OnPetChanged()
	{
		selectedVisitId = null;

		await LoadPetVisitsAsync();
	}

	private async Task OpenCreateForm()
	{
		isEditing = false;
		editingVaccinationId = Guid.Empty;

		selectedPetId = null;
		selectedVisitId = null;

		petSearchTerm = string.Empty;

		pets = (await PetManagement.SearchForSelectionAsync(
			null)).ToList();

		visits.Clear();

		vaccineName = string.Empty;
		batchNumber = string.Empty;
		vaccinatedAt = DateOnly.FromDateTime(DateTime.Today);
		nextDueAt = null;
		notes = string.Empty;

		errorMessage = null;
		isFormOpen = true;
	}

	private async Task OpenEditForm(VaccinationDto vaccination)
	{
		isEditing = true;

		editingVaccinationId = vaccination.Id;
		selectedPetId = vaccination.PetId;
		selectedVisitId = vaccination.VisitId;

		vaccineName = vaccination.VaccineName;
		batchNumber = vaccination.BatchNumber;
		vaccinatedAt = vaccination.VaccinatedAt;
		nextDueAt = vaccination.NextDueAt;
		notes = vaccination.Notes;

		errorMessage = null;

		await LoadPetVisitsAsync();

		isFormOpen = true;
	}

	private void CloseForm()
	{
		isFormOpen = false;
	}

	private async Task SaveVaccination()
	{
		try
		{
			errorMessage = null;
			successMessage = null;

			if (!selectedPetId.HasValue)
			{
				errorMessage = "Выберите питомца.";
				return;
			}

			if (string.IsNullOrWhiteSpace(vaccineName))
			{
				errorMessage = "Укажите название вакцины.";
				return;
			}

			if (nextDueAt.HasValue && nextDueAt.Value < vaccinatedAt)
			{
				errorMessage =
					"Дата следующей вакцинации не может быть раньше текущей.";
				return;
			}

			var wasEditing = isEditing;

			if (isEditing)
			{
				var dto = new UpdateVaccinationDto(
					editingVaccinationId,
					selectedVisitId,
					vaccineName.Trim(),
					batchNumber.Trim(),
					vaccinatedAt,
					nextDueAt,
					notes.Trim());

				var updated = await VaccinationManagement.UpdateAsync(dto);

				if (!updated)
				{
					errorMessage = "Не удалось обновить вакцинацию.";
					return;
				}
			}
			else
			{
				var dto = new CreateVaccinationDto(
					selectedPetId.Value,
					selectedVisitId,
					vaccineName.Trim(),
					batchNumber.Trim(),
					vaccinatedAt,
					nextDueAt,
					notes.Trim());

				await VaccinationManagement.CreateAsync(dto);
			}

			CloseForm();

			await LoadData();

			successMessage = wasEditing
				? "Вакцинация успешно обновлена."
				: "Вакцинация успешно добавлена.";
		}
		catch (Exception ex)
		{
			errorMessage = $"Не удалось сохранить вакцинацию: {ex.Message}";
		}
	}

	private async Task GoToPageAsync(int page)
	{
		if (page < 1 || page > totalPages || page == currentPage)
			return;

		currentPage = page;

		await LoadData();
	}

	private async Task DeleteVaccination(VaccinationDto vaccination)
	{
		var confirmed = await JS.InvokeAsync<bool>(
			"confirm",
			"Вы действительно хотите удалить эту запись о вакцинации?");

		if (!confirmed)
			return;

		try
		{
			errorMessage = null;
			successMessage = null;

			var deleted = await VaccinationManagement.DeleteAsync(
				vaccination.Id);

			if (!deleted)
			{
				errorMessage = "Не удалось удалить запись о вакцинации.";
				return;
			}

			await LoadData();

			successMessage = "Запись о вакцинации успешно удалена.";
		}
		catch (Exception ex)
		{
			errorMessage = $"Не удалось удалить вакцинацию: {ex.Message}";
		}
	}
}
